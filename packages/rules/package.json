{
  "name": "@xufa/rules",
  "version": "0.1.0",
  "description": "Business rules in Excel workbooks (decision tables, spreadsheets, tests) run as functions, with safe compiled expressions",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "xufa-test",
    "test:types": "xufa-test --typecheck.only"
  },
  "keywords": [
    "rules",
    "rules-engine",
    "decision-table",
    "excel",
    "xlsx",
    "business-rules"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/rules"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/rules#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@xufa/expression": "workspace:*",
    "@xufa/xlsx": "workspace:*"
  },
  "devDependencies": {
    "@xufa/http": "workspace:*",
    "@xufa/orm": "workspace:*",
    "@xufa/test": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
