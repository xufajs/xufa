{
  "name": "@xufa/openapi",
  "version": "0.1.0",
  "description": "OpenAPI 3 and Swagger 2 documents of the routes of an app, with the API of @fastify/swagger and its tests, and an explorer; without dependencies but @xufa/yaml",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "types": "./ui.d.ts",
      "default": "./lib/ui.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "LICENSE",
    "LICENSE.fastify-swagger",
    "types",
    "ui.d.ts"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tstyche"
  },
  "keywords": [
    "openapi",
    "swagger",
    "documentation",
    "json-schema",
    "fastify"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/openapi#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xufa/yaml": "workspace:*"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/swagger": "9.9.1",
    "@xufa/auth": "workspace:*",
    "@xufa/http": "workspace:*",
    "@xufa/orm": "workspace:*",
    "fastify": "^5.12.5",
    "fluent-json-schema": "^6.0.0",
    "joi": "^17.13.1",
    "joi-to-json": "^5.0.0",
    "openapi-types": "^12.1.3",
    "qs": "^6.12.1",
    "tsd": "^0.33.0",
    "tstyche": "^7.2.5",
    "vyntra": "^0.6.0",
    "yaml": "^2.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
