{
  "name": "@xufa/mongo",
  "version": "0.1.0",
  "description": "A MongoDB driver (BSON, wire protocol, SCRAM, sessions and transactions) with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "mongodb",
    "mongo",
    "driver",
    "bson",
    "database"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/mongo"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/mongo#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "vyntra": "^0.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test/types"
  }
}
