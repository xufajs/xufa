{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "sequelize": ["../../types/index.d.ts"],
      "sequelize/lib/*": ["../../types/*"],
      "sequelize/types/*": ["../../types/*"]
    }
  },
  "include": ["./**/*.ts"]
}
