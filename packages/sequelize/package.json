{
  "name": "@xufa/sequelize",
  "version": "0.1.0",
  "description": "The API of Sequelize 6 over @xufa/orm: models, associations, queries and transactions, with no dependencies",
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "types"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsc --project ./test/types/tsconfig.json"
  },
  "keywords": [
    "orm",
    "sequelize",
    "database",
    "sql",
    "sqlite",
    "postgresql"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/sequelize"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/sequelize#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@xufa/orm": "workspace:*"
  },
  "devDependencies": {
    "expect-type": "^0.12.0",
    "vyntra": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
