{
  "name": "@xufa/http",
  "version": "0.1.0",
  "description": "The HTTP framework of xufa: the API of fastify, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "lib",
    "index.d.ts",
    "types"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tstyche"
  },
  "keywords": [
    "web",
    "framework",
    "http",
    "server",
    "fast",
    "router",
    "json",
    "schema"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xufa/boot": "workspace:*",
    "@xufa/errors": "workspace:*",
    "@xufa/inject": "workspace:*",
    "@xufa/logger": "workspace:*",
    "@xufa/router": "workspace:*",
    "@xufa/serializer": "workspace:*"
  },
  "peerDependencies": {
    "schiva": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "schiva": {
      "optional": true
    }
  },
  "devDependencies": {
    "JSONStream": "^1.3.5",
    "abstract-logging": "^2.0.1",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "ajv-merge-patch": "^5.0.1",
    "fast-json-body": "^1.1.0",
    "fluent-json-schema": "^6.0.0",
    "h2url": "^0.2.0",
    "http-errors": "^2.0.0",
    "joi": "^18.0.1",
    "json-schema-to-ts": "^3.1.1",
    "node-forge": "^1.3.1",
    "proxyquire": "^2.1.3",
    "rfdc": "^1.4.1",
    "schiva": "^0.7.0",
    "split2": "^4.2.0",
    "typebox": "^1.3.34",
    "undici": "^7.16.0",
    "vary": "^1.1.2",
    "vyntra": "^0.6.0",
    "yup": "^1.4.0"
  },
  "vyntra": {
    "exclude": [
      "**/node_modules/**",
      "test/fixtures/**",
      "test/helpers/**"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
