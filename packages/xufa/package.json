{
  "name": "xufa",
  "version": "0.1.0",
  "description": "A framework for Node.js in the spirit of Django: HTTP (with the API of fastify), an ORM over SQL and NoSQL databases and authentication, with no dependencies",
  "main": "./index.js",
  "bin": {
    "xufa": "./bin/xufa.js"
  },
  "types": "./index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./orm": {
      "types": "./orm.d.ts",
      "default": "./orm.js"
    },
    "./auth": {
      "types": "./auth.d.ts",
      "default": "./auth.js"
    },
    "./admin": {
      "types": "./admin.d.ts",
      "default": "./admin.js"
    },
    "./session": {
      "types": "./session.d.ts",
      "default": "./session.js"
    },
    "./expression": {
      "types": "./expression.d.ts",
      "default": "./expression.js"
    },
    "./template": {
      "types": "./template.d.ts",
      "default": "./template.js"
    },
    "./mail": {
      "types": "./mail.d.ts",
      "default": "./mail.js"
    },
    "./i18n": {
      "types": "./i18n.d.ts",
      "default": "./i18n.js"
    },
    "./package.json": "./package.json",
    "./openapi": {
      "types": "./openapi.d.cts",
      "default": "./openapi.js"
    },
    "./openapi/ui": {
      "types": "./openapi-ui.d.cts",
      "default": "./openapi-ui.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./scheduler": {
      "types": "./scheduler.d.ts",
      "default": "./scheduler.js"
    },
    "./queue": {
      "types": "./queue.d.ts",
      "default": "./queue.js"
    },
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "default": "./schema.js"
    },
    "./faults": {
      "types": "./faults.d.ts",
      "default": "./faults.js"
    },
    "./faults/register": {
      "types": "./faults-register.d.ts",
      "default": "./faults-register.js"
    },
    "./faults/register-strict": {
      "types": "./faults-register-strict.d.ts",
      "default": "./faults-register-strict.js"
    },
    "./forms": {
      "types": "./forms.d.ts",
      "default": "./forms.js"
    },
    "./views": {
      "types": "./views.d.ts",
      "default": "./views.js"
    },
    "./apps": {
      "types": "./apps.d.ts",
      "default": "./apps.js"
    },
    "./project": {
      "types": "./project.d.ts",
      "default": "./project.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./testing.js"
    }
  },
  "files": [
    "index.js",
    "index.d.cts",
    "orm.js",
    "orm.d.ts",
    "auth.js",
    "auth.d.ts",
    "admin.js",
    "admin.d.ts",
    "session.js",
    "session.d.ts",
    "expression.js",
    "expression.d.ts",
    "template.js",
    "mail.js",
    "mail.d.ts",
    "forms.js",
    "forms.d.ts",
    "views.js",
    "views.d.ts",
    "apps.js",
    "apps.d.ts",
    "project.js",
    "project.d.ts",
    "testing.js",
    "testing.d.ts",
    "i18n.js",
    "i18n.d.ts",
    "template.d.ts",
    "openapi.js",
    "openapi.d.cts",
    "openapi-ui.js",
    "openapi-ui.d.cts",
    "client.js",
    "client.d.ts",
    "scheduler.js",
    "scheduler.d.ts",
    "queue.js",
    "queue.d.ts",
    "config.js",
    "config.d.ts",
    "schema.js",
    "schema.d.ts",
    "faults.js",
    "faults.d.ts",
    "faults-register.js",
    "faults-register.d.ts",
    "faults-register-strict.js",
    "faults-register-strict.d.ts",
    "bin",
    "lib"
  ],
  "scripts": {
    "test": "vyntra"
  },
  "keywords": [
    "framework",
    "web",
    "http",
    "orm",
    "django",
    "fastify",
    "template"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/xufa"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/xufa#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@xufa/admin": "workspace:*",
    "@xufa/auth": "workspace:*",
    "@xufa/client": "workspace:*",
    "@xufa/config": "workspace:*",
    "@xufa/expression": "workspace:*",
    "@xufa/faults": "workspace:*",
    "@xufa/forms": "workspace:*",
    "@xufa/views": "workspace:*",
    "@xufa/yaml": "workspace:*",
    "@xufa/http": "workspace:*",
    "@xufa/i18n": "workspace:*",
    "@xufa/mail": "workspace:*",
    "@xufa/openapi": "workspace:*",
    "@xufa/orm": "workspace:*",
    "@xufa/queue": "workspace:*",
    "@xufa/scheduler": "workspace:*",
    "@xufa/schema": "workspace:*",
    "@xufa/session": "workspace:*",
    "@xufa/template": "workspace:*"
  },
  "devDependencies": {
    "vyntra": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "vyntra": {
    "setupFiles": [
      "@xufa/faults/register-strict"
    ]
  }
}
