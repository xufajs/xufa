{
  "name": "@xufa/test-ai",
  "version": "0.1.0",
  "description": "AI steps for @xufa/test: an agent that drives a page toward a goal and judges claims about it, and expect(value).toSatisfy(claim), all through a replay cache committed to the repository, so CI makes no model calls.",
  "type": "commonjs",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node ../test/bin/xufa-test.js"
  },
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/test-ai"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/test-ai#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0",
    "@xufa/test": "workspace:^"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "@xufa/test": "workspace:*"
  },
  "xufaTest": {
    "exclude": [
      "**/node_modules/**",
      "test/fixtures/**"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
