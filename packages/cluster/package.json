{
  "name": "@xufa/cluster",
  "version": "0.1.0",
  "description": "An app in a cluster of processes, the messages between them, and pools of nodes shared by its workers, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "xufa-test",
    "test:types": "xufa-test --typecheck.only"
  },
  "keywords": [
    "cluster",
    "workers",
    "ipc",
    "messages",
    "pool",
    "autoscale"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/cluster"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/cluster#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "@xufa/discovery": "workspace:*",
    "@xufa/netcache": "workspace:*",
    "@xufa/orm": "workspace:*",
    "@xufa/test": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xufa/faults": "workspace:*",
    "@xufa/marshal": "workspace:*"
  },
  "xufaTest": {
    "setupFiles": [
      "@xufa/faults/register-strict"
    ]
  },
  "peerDependencies": {
    "@xufa/orm": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xufa/orm": {
      "optional": true
    }
  }
}
