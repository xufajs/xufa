{
  "name": "@xufa/pg",
  "version": "0.1.0",
  "description": "A PostgreSQL driver with the API of pg: pipelined, with prepared statements, and no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "xufa-test",
    "test:types": "xufa-test --typecheck.only"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "pg",
    "driver",
    "database"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/pg"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/pg#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "@xufa/test": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
