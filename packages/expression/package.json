{
  "name": "@xufa/expression",
  "version": "0.1.0",
  "description": "Safe JavaScript expressions compiled once and run many times on data, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "expression",
    "evaluator",
    "sandbox",
    "safe",
    "formula"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/expression"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/expression#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "vyntra": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test/types"
  }
