{
  "name": "@xufa/websocket",
  "version": "0.1.0",
  "description": "WebSockets (RFC 6455, permessage-deflate): client and server with the API and the tests of ws, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.js"
      }
    },
    "./plugin": {
      "types": "./plugin.d.cts",
      "default": "./lib/plugin.js"
    },
    "./package.json": "./package.json",
    "./hub": {
      "types": "./hub.d.ts",
      "default": "./lib/hub.js"
    }
  },
  "files": [
    "index.js",
    "index.d.cts",
    "plugin.d.cts",
    "lib",
    "LICENSE",
    "LICENSE.ws",
    "hub.d.ts",
    "index.d.mts"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "websocket",
    "websockets",
    "ws",
    "rfc6455",
    "realtime",
    "server",
    "client"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/websocket"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/websocket#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "tsd": {
    "directory": "test/types"
  },
  "devDependencies": {
    "@xufa/http": "workspace:*",
    "tsd": "^0.33.0",
    "vyntra": "^0.7.0",
    "split2": "^4.2.0",
    "@xufa/cluster": "workspace:*",
    "@xufa/netcache": "workspace:*",
    "bufferutil": "^4.1.0"
  },
  "peerDependencies": {
    "bufferutil": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "bufferutil": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
