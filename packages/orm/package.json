{
  "name": "@xufa/orm",
  "version": "0.1.0",
  "description": "The ORM of xufa: Django-like models and querysets over SQL and NoSQL databases, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "orm",
    "database",
    "sql",
    "sqlite",
    "postgresql",
    "mongodb",
    "django"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/orm#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@xufa/errors": "workspace:*",
    "@xufa/expression": "workspace:*",
    "@xufa/faults": "workspace:*",
    "@xufa/mongo": "workspace:*",
    "@xufa/pg": "workspace:*",
    "@xufa/schema": "workspace:*"
  },
  "devDependencies": {
    "@xufa/cluster": "workspace:*",
    "@xufa/http": "workspace:*",
    "vyntra": "^0.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test/types"
  },
  "vyntra": {
    "setupFiles": [
      "@xufa/faults/register-strict"
    ]
  }
}
