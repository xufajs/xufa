{
  "name": "@xufa/admin",
  "version": "0.1.0",
  "description": "The admin of the models of @xufa/orm, as Django's, with no dependencies to install: a React page (built in) with lists, search, filters, order and pages, forms from the fields with their validation, jobs and pipeline runs, roles and tenants, as a plugin of @xufa/http",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "node client/build.js",
    "build:check": "node client/build.js --check",
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "admin",
    "crud",
    "backoffice",
    "orm",
    "django"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/admin#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "@xufa/auth": "workspace:*",
    "@xufa/http": "workspace:*",
    "@xufa/queue": "workspace:*",
    "@xufa/scheduler": "workspace:*",
    "@xufa/session": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsd": "^0.33.0",
    "vyntra": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test/types"
  },
  "dependencies": {
    "@xufa/orm": "workspace:*"
  },
  "peerDependencies": {
    "@xufa/auth": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xufa/auth": {
      "optional": true
    }
  }
}
