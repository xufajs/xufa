{
  "name": "@xufa/config",
  "version": "0.1.0",
  "description": "The configuration of an app from layers (files by environment, .env, variables, HTTP, Consul, Vault, folders of secrets, overrides), with safe templates, a schema that converts and checks, and secrets redacted",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./dotenv": {
      "types": "./dotenv.d.cts",
      "default": "./dotenv.js"
    },
    "./dotenv/config": {
      "types": "./dotenv-config.d.ts",
      "default": "./dotenv-config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dotenv.js",
    "dotenv.d.cts",
    "dotenv-config.js",
    "dotenv-config.d.ts",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "test": "xufa-test",
    "test:types": "xufa-test --typecheck.only"
  },
  "keywords": [
    "config",
    "configuration",
    "settings",
    "env",
    "dotenv",
    "yaml",
    "schema"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {
    "@xufa/expression": "workspace:*",
    "@xufa/yaml": "workspace:*"
  },
  "devDependencies": {
    "@xufa/test": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
