{
  "name": "@xufa/forms",
  "version": "0.1.0",
  "description": "Forms of a site, as django.forms: fields that clean what a body gives (texts, dates, choices, objects of a model, files), forms with their errors by field and their HTML, and forms of models of @xufa/orm (ModelForm) checked by the model, with no dependencies",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "test": "vyntra",
    "test:types": "tsd"
  },
  "keywords": [
    "forms",
    "validation",
    "html",
    "modelform",
    "django"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/forms"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@xufa/orm": "workspace:*",
    "@xufa/http": "workspace:*",
    "@xufa/template": "workspace:*",
    "tsd": "^0.33.0",
    "vyntra": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test/types"
  },
  "peerDependencies": {
    "@xufa/orm": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xufa/orm": {
      "optional": true
    }
  }
}
