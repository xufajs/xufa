{
  "name": "@xufa/netcache",
  "version": "0.1.0",
  "description": "A cache shared by the machines of a service: a copy in each, writes sent to all over TCP (sealed with a secret), nodes found by @xufa/discovery",
  "main": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "xufa-test",
    "test:types": "xufa-test --typecheck.only"
  },
  "keywords": [
    "cache",
    "distributed cache",
    "replicated",
    "cluster",
    "shared"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git",
    "directory": "packages/netcache"
  },
  "homepage": "https://github.com/xufajs/xufa/tree/main/packages/netcache#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "@xufa/orm": "workspace:*",
    "@xufa/test": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xufa/discovery": "workspace:*",
    "@xufa/faults": "workspace:*",
    "@xufa/marshal": "workspace:*"
  },
  "xufaTest": {
    "setupFiles": [
      "@xufa/faults/register-strict"
    ]
  }
}
