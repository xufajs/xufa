node_modules
coverage
# The coverage of @xufa/test is its code (its reports are what the line above leaves out).
!packages/test/src/coverage/
bench/results/*.json
# Results the docs are built from.
!bench/results/inproc-linux-2.json
.xufa-test
# The node_modules of the fixtures of @xufa/test are part of them.
!packages/test*/test/fixtures/**/node_modules/
packages/test*/test/fixtures/**/node_modules/.cache/
*.log

# The MongoDB replica set of the tests (tools/mongo-rs.js).
.mongo-rs/
# Folders the tests make (and remove): left by a run that stopped
.tmp-*/

# Python bytecode (the Django app of the benchmarks, examples/django-locallibrary).
__pycache__/
*.py[cod]
