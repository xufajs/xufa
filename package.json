{
  "name": "xufa-monorepo",
  "private": true,
  "type": "module",
  "description": "xufa: a framework for Node.js in the spirit of Django, with no dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xufajs/xufa.git"
  },
  "homepage": "https://github.com/xufajs/xufa#readme",
  "bugs": {
    "url": "https://github.com/xufajs/xufa/issues"
  },
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "scripts": {
    "test": "pnpm -r --filter ./packages/** test",
    "lint": "xufa-lint",
    "lintfix": "xufa-lint --fix",
    "format": "xufa-format --write",
    "format:check": "xufa-format --check",
    "build:check": "pnpm --filter @xufa/admin build:check && pnpm --filter @xufa/lint build:format:check && pnpm --filter @xufa/test build-docs:check",
    "bench": "node bench/run.js",
    "bench:quick": "node bench/run.js --duration 3 --warmup 1 --rounds 1",
    "docs": "node tools/docs/build.js",
    "docs:check": "node tools/docs/jsdoc-comments.js --check && node tools/docs/build.js --check && node tools/docs/crawl.js && node tools/docs/examples/run.js && node tools/docs/examples/types.js",
    "test:types": "pnpm -r --filter \"./packages/**\" test:types",
    "bench:linux": "node tools/bench-linux/run.js",
    "docs:crawl": "node tools/docs/crawl.js",
    "test:linux": "node tools/bench-linux/test.js",
    "docs:examples": "node tools/docs/examples/run.js",
    "docs:types": "node tools/docs/examples/types.js",
    "mongo:rs": "node tools/mongo-rs.js"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=25.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xufa/browser": "workspace:^",
    "@xufa/bundle": "workspace:^",
    "@xufa/lint": "workspace:^",
    "fastify-plugin": "^5.1.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.32.1"
}
