    "fastify-plugin": "^5.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "tsd": "^0.33.0",
    "tstyche": "^7.2.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.32.1"
}
