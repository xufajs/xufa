# The database: sqlite:data/locallibrary.db (default), postgres://user:password@host:5432/name, mongodb://host/name, memory:
DATABASE_URL=sqlite:data/locallibrary.db
# Signs the cookies of the sessions and the links of password resets (32 characters or more).
SECRET_KEY=change-me-to-32-random-characters-or-more
PORT=8000
SITE_URL=http://127.0.0.1:8000
